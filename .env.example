# Copy to .env at the repository root. Process environment overrides this file.
APP_ENV=development
# Relative paths are always resolved against the repository root, not cwd.
DATA_DIR=data
# Omit DATABASE_URL to use DATA_DIR/app.db. Optional override:
# DATABASE_URL=sqlite:///data/app.db
# Comma-separated browser origins (no JSON, no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# M0.3 CPU baseline. Download the model during setup; imports do not fetch it implicitly.
STT_MODEL=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_VAD_FILTER=true
# Omit to use DATA_DIR/cache/faster-whisper/{STT_MODEL}. Relative paths use the repo root.
# STT_MODEL_PATH=data/cache/faster-whisper/base.en
